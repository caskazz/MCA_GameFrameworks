<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="energy-bar-bg" style="flex-grow: 1; width: 300px; height: 100px; position: absolute; border-left-color: rgb(15, 95, 12); border-right-color: rgb(15, 95, 12); border-top-color: rgb(15, 95, 12); border-bottom-color: rgb(15, 95, 12); border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 8px;">
        <ui:VisualElement name="energy-bar-mask" style="flex-grow: 1; position: relative; overflow: hidden; color: rgb(0, 255, 0); background-color: rgb(0, 255, 0); transition-property: width; transition-duration: 0.5s; transition-timing-function: ease-out-bounce;">
            <ui:VisualElement name="energy-bar-fill" style="flex-grow: 1;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="money_text_label" style="flex-grow: 1; position: absolute; width: 452px; height: 100px; right: 0;"/>
</ui:UXML>
