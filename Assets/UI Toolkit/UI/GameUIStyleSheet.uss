:root {
}

.Label-style {
    font-size: 64px;
    -unity-text-outline-color: rgb(0, 0, 0);
    color: rgb(0, 0, 0);
}

.button {
    width: 500px;
    align-self: center;
    height: 100px;
    background-color: rgb(230, 178, 211);
    font-size: 59px;
}

.button:hover {
    width: 500px;
    align-self: center;
    height: 100px;
    background-color: rgb(222, 149, 139);
    font-size: 59px;
    color: rgb(255, 255, 255);
}
